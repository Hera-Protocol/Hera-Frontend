PORT=4242
# The whsec_… secret shown once when you create the endpoint in the dashboard (Settings → Webhooks).
# send-test-event uses the same value, so leave the default to try it locally.
HERA_WEBHOOK_SECRET=whsec_local_example_secret_change_me
# Optional: lets report.ready download the PDF. Needs the read scope.
HERA_API_KEY=
HERA_BASE_URL=https://api.heralayer.com/v1
