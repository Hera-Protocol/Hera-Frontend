# Leave empty for the offline demo (simulated Hera responses; local EIP-55 validation is real).
HERA_API_KEY=
HERA_BASE_URL=https://api.heralayer.com/v1

# Dry run (default) prints the decision and never touches a wallet.
DRY_RUN=1
# Only for DRY_RUN=0: a Sepolia private key and RPC. Never use a mainnet key here.
PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
