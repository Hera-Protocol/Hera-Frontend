# Leave HERA_API_KEY empty to run the offline demo (simulated Hera responses, real local validation).
HERA_API_KEY=
# Point at a local API while developing: http://localhost:4000/v1
HERA_BASE_URL=https://api.heralayer.com/v1

# Optional: a TESTNET secret key (S…) to sign with. Without it a random keypair is used and nothing is submitted.
STELLAR_SECRET=
# Set to 1 to actually submit to the Stellar TESTNET (needs STELLAR_SECRET with testnet funds).
SUBMIT=0
