{
  "name": "@hera/api",
  "version": "0.1.0",
  "private": true,
  "description": "Hera compliance API: screening, monitoring, alerts, Travel Rule, audit.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @hera/core build && nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "openapi": "nest build && node dist/openapi/cli.js",
    "test:pg": "node test/run-pg.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@electric-sql/pglite": "0.3.16",
    "@hera/core": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.7.1",
    "@react-pdf/renderer": "4.9.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "nodemailer": "10.0.10",
    "pg": "8.23.1",
    "react": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.9",
    "vitest": "3.2.4"
  }
}
