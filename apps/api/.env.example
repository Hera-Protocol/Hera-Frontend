# Copy to apps/api/.env. Every variable is optional in development.
NODE_ENV=development
PORT=4000
# CORS origin, and the base URL for links in email and report footers.
WEB_ORIGIN=http://localhost:3000

# Postgres. Leave unset to use embedded PGlite persisted at apps/api/.data/pg.
# DATABASE_URL=postgres://hera:hera@localhost:5432/hera
# Root for PGlite, mail drops and local report files.
# DATA_DIR=./.data

SESSION_COOKIE_NAME=hera_session
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# HMAC key for API key secrets. Required in production: changing it invalidates every key.
# API_KEY_PEPPER=change-me-to-32-random-bytes

# Email. "log" (default outside production) writes messages to .data/mail/;
# "smtp" (default in production) sends through SMTP_URL.
# MAIL_DRIVER=log
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Hera <no-reply@heralayer.com>"

# AES-256-GCM key for webhook signing secrets at rest: 32 bytes, base64 (openssl rand -base64 32).
# Required in production; changing it makes stored secrets unreadable.
# WEBHOOK_SECRET_KEY=
# Outbox poll interval in ms. 0 disables delivery.
WEBHOOK_DISPATCH_INTERVAL_MS=2000

# Report job runner poll interval in ms. 0 disables background (audit) reports.
REPORT_JOB_INTERVAL_MS=5000

# Wallet monitor interval in ms. 0 disables the monitor.
MONITOR_INTERVAL_MS=120000
# Chain-data budget for screens a caller waits on. The monitor uses core's fuller defaults.
# SCREEN_DEADLINE_MS=8000
# SCREEN_MAX_PAGES=2
# HORIZON_URL=https://horizon.stellar.org

# Which proxies to trust for X-Forwarded-For (Express "trust proxy" syntax).
# TRUST_PROXY=loopback

# Requests per minute per IP.
# AUTH_RATE_LIMIT=10
# SCREEN_RATE_LIMIT=60
# VERIFY_RATE_LIMIT=30
